# ─────────────────────────────────────────────────────────────
# Prized — Environment Variables (Beispiel)
# Kopiere diese Datei zu `.env` und fülle die Werte aus.
# Ohne Supabase-Werte läuft die App im Gast-Modus (nur Demo-Decks).
# ─────────────────────────────────────────────────────────────

# Supabase (optional) — für Accounts + Cloud-Sync von Decks & History.
# WICHTIG: VITE_*-Variablen landen im öffentlichen Client-Bundle.
# Nur den ANON-(public-)Key verwenden — NIEMALS den service_role-Key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google-Login-Feature-Flag (1 = aktiviert, 0/leer = deaktiviert)
VITE_GOOGLE_ENABLED=0

# Express-Static-Server (server/index.js) — Port für `npm start`
PORT=8080

# Admin-API für die control-plane-CRM-Anbindung (optional, siehe
# specs/admin-api.md). Server-seitig, KEIN VITE_-Prefix — darf nie ins
# Client-Bundle. Ohne beide Werte bleibt /api/admin/* deaktiviert.
# service_role-Key: Supabase-Dashboard → Project Settings → API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Bearer-Token, den control-plane bei jedem Admin-Request mitschickt.
PRIZED_SERVICE_TOKEN=generate-a-long-random-secret
